generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                Int         @id @default(autoincrement())
  name              String
  price             Int
  description       String?
  category          String?
  priceNote         String?
  imageUrl          String?
  supplierVariantId String?
  fulfillmentType   String?     @default("HYBRID")
  isActive          Boolean     @default(true)
  stocks            StockItem[]
  orders            Order[]
  createdAt         DateTime    @default(now())
}

model StockItem {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      String
  isSold    Boolean  @default(false)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId, isSold])
}

model Order {
  id          String      @id
  telegramId  String
  username    String?
  productId   Int
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int         @default(1)
  totalAmount Int
  status      String      @default("PENDING")
  qrMessageId Int?
  stocks      StockItem[]
  createdAt   DateTime    @default(now())
  paidAt      DateTime?

  @@index([telegramId, status])
}

model TelegramUser {
  id        String   @id
  username  String?
  firstName String?
  createdAt DateTime @default(now())
}

model WebAuthSession {
  token      String   @id
  telegramId String?
  username   String?
  firstName  String?
  photoUrl   String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([token, isVerified])
}

model BotHeartbeat {
  id       Int    @id @default(1)
  lastPing BigInt
}

model Coupon {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  discount  Int
  isPercent Boolean  @default(false)
  maxUsage  Int      @default(100)
  usedCount Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Giveaway {
  id           Int                   @id @default(autoincrement())
  title        String
  reward       String
  description  String?
  winnerCount  Int                   @default(1)
  status       String                @default("ACTIVE")
  createdAt    DateTime              @default(now())
  endedAt      DateTime?
  participants GiveawayParticipant[]
  winners      GiveawayWinner[]
}

model GiveawayParticipant {
  id         Int      @id @default(autoincrement())
  giveawayId Int
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  telegramId String
  username   String?
  firstName  String?
  createdAt  DateTime @default(now())

  @@unique([giveawayId, telegramId])
}

model GiveawayWinner {
  id         Int      @id @default(autoincrement())
  giveawayId Int
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  telegramId String
  username   String?
  createdAt  DateTime @default(now())
}
