generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Int
  description String?
  category    String?
  priceNote         String?
  imageUrl          String?
  supplierVariantId String?
  fulfillmentType   String?     @default("HYBRID")
  isActive          Boolean     @default(true)
  stocks      StockItem[]
  orders      Order[]
  createdAt   DateTime    @default(now())
}

model StockItem {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      String
  isSold    Boolean  @default(false)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId, isSold])
}

model Order {
  id          String      @id
  telegramId  String
  username    String?
  productId   Int
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int         @default(1)
  totalAmount Int
  status      String      @default("PENDING")
  qrMessageId Int?
  stocks      StockItem[]
  createdAt   DateTime    @default(now())
  paidAt      DateTime?

  @@index([telegramId, status])
}

model TelegramUser {
  id        String   @id
  username  String?
  firstName String?
  createdAt DateTime @default(now())
}
