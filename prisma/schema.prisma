generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
  runtime    = "workerd"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Product {
  id                Int         @id @default(autoincrement())
  name              String
  price             Int
  description       String?
  category          String?
  warranty          String?
  priceNote         String?
  imageUrl          String?
  supplierVariantId String?
  fulfillmentType   String?     @default("HYBRID")
  retailMarginPercent Int       @default(15)
  lastSupplierPrice   Int?
  autoPriceSync       Boolean   @default(true)
  isActive          Boolean     @default(true)
  stocks            StockItem[]
  orders            Order[]
  supplierPurchases SupplierPurchase[]
  restockSubscriptions RestockSubscription[]
  createdAt         DateTime    @default(now())
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SupplierPurchase {
  id                     String    @id
  requestHash            String
  supplierProductId      String
  supplierProductName    String
  quantity               Int
  maxTotalVnd            Int
  targetProductId        Int?
  createProductName      String?
  createProductCategory  String?
  createProductRetailPrice Int?
  status                 String    @default("PENDING")
  supplierOrderId        String?   @unique
  totalVnd               Int?
  itemCount              Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  targetProduct          Product?  @relation(fields: [targetProductId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([supplierProductId, createdAt])
}

model StockItem {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      String
  isSold    Boolean  @default(false)
  isFaulty  Boolean  @default(false)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId, isSold])
}

model Order {
  id                  String      @id
  telegramId          String
  username            String?
  productId           Int
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity            Int         @default(1)
  totalAmount         Int
  status              String      @default("PENDING")
  qrMessageId         Int?
  stocks              StockItem[]
  warrantyCount       Int         @default(0)
  warrantyReplacedAt  DateTime?
  warrantyNote        String?
  createdAt           DateTime    @default(now())
  paidAt              DateTime?

  @@index([telegramId, status])
}

model RestockSubscription {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  telegramId String
  username   String?
  createdAt  DateTime @default(now())

  @@unique([productId, telegramId])
  @@index([productId])
  @@index([telegramId])
}

model TelegramUser {
  id        String   @id
  username  String?
  firstName String?
  balance   Int      @default(0)
  createdAt DateTime @default(now())
}

model WebAuthSession {
  token      String   @id
  telegramId String?
  username   String?
  firstName  String?
  photoUrl   String?
  isVerified Boolean  @default(false)
  sessionToken String? @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([token, isVerified])
}

model CustomerSession {
  token      String   @id
  telegramId String
  username   String?
  firstName  String?
  expiresAt  DateTime

  @@index([telegramId, expiresAt])
}

model BotHeartbeat {
  id       Int    @id @default(1)
  lastPing BigInt
}

model Coupon {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  discount  Int
  isPercent Boolean  @default(false)
  maxUsage  Int      @default(100)
  usedCount Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Giveaway {
  id           Int                   @id @default(autoincrement())
  title        String
  reward       String
  description  String?
  winnerCount  Int                   @default(1)
  status       String                @default("ACTIVE")
  createdAt    DateTime              @default(now())
  endedAt      DateTime?
  participants GiveawayParticipant[]
  winners      GiveawayWinner[]
}

model GiveawayParticipant {
  id         Int      @id @default(autoincrement())
  giveawayId Int
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  telegramId String
  username   String?
  firstName  String?
  createdAt  DateTime @default(now())

  @@unique([giveawayId, telegramId])
}

model GiveawayWinner {
  id         Int      @id @default(autoincrement())
  giveawayId Int
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  telegramId String
  username   String?
  createdAt  DateTime @default(now())
}

model WalletTransaction {
  id          String   @id
  telegramId  String
  amount      Int
  type        String   @default("DEPOSIT")
  status      String   @default("PENDING")
  description String?
  qrMessageId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([telegramId, createdAt])
  @@index([status, createdAt])
}
